# Public (browser) settings — safe to expose. Never put a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-project-anon-or-publishable-key

# Optional: show the "Demo" sign-in hint on the login page (local/demo deployments only)
VITE_SHOW_DEMO_LOGIN=false

# Tests only (never shipped to the browser)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
